# Copy this file to .env.local (gitignored) and fill in the values.
# Next.js loads .env.local into process.env on the server only; none of
# these values reach the browser (none starts with NEXT_PUBLIC_).

# --- Contact form (Resend) -------------------------------------------------
# API key from https://resend.com/api-keys ("Sending access" is enough).
RESEND_API_KEY=

# Where contact-form messages are delivered: Rachel's inbox.
CONTACT_TO_EMAIL=

# The sender. Its domain must be verified in Resend (Domains -> Add domain,
# then add the DNS records it shows). Until then, use the Resend test sender
# "Rachel Siegel website <onboarding@resend.dev>", which only delivers to the
# address you signed up to Resend with.
CONTACT_FROM_EMAIL="Rachel Siegel website <website@example.com>"

# --- Upcoming events (optional) --------------------------------------------
# Override the calendar feed URL from the site config.
# CALENDAR_FEED_URL=
# Where the events cache lives (default: data/events.sqlite).
# EVENTS_CACHE_PATH=
# Set to 1 to enable the /api/revalidate endpoint.
# ON_DEMAND_REVALIDATION=
