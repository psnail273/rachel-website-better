#!/usr/bin/env bash
# The smoke step: the app built for production and started, then each of its
# page routes loaded in three headless browsers, Chromium, Firefox and WebKit
# (Safari's engine), at phone and desktop widths, in a light and a dark colour
# scheme, with accessibility checks on each (axe, reflow at 320 px, focus in
# forced colours) and a check of the links between them.
#   bash tools/verify/smoke
#
#   0. _routes.mjs reads the page routes from ARCHITECTURE.md's `## Routes`
#      table: each line whose first field is a path starting with `/`, but a
#      route handler's (its file route.ts) and a dynamic one's (`[slug]`, a note
#      on stderr); none is a finding, before any build;
#   1. next build (offline: NEXT_TELEMETRY_DISABLED, and arch's R10 keeps fonts
#      local), under the machine-wide build lock (_nextjs.sh's nx_next_build), so
#      builds in other worktrees, Lands and playtests queue instead of colliding;
#   2. next start on 127.0.0.1, on a port the OS picks free (--port 0; the step
#      reads the port from the URL next start prints), so runs side by side
#      never meet; the step polls until the port takes a connection (1 and 2
#      are _server.sh's, shared with the Scenario driver);
#   3. _smoke_page.mjs: one Chromium, one Firefox and one WebKit (Playwright,
#      the project's @playwright/test; bootstrap installs the three into
#      PLAYWRIGHT_BROWSERS_PATH), running at once, for every route: each loads
#      each route in each view (the window 900 tall, reduced motion), waits for
#      its network to go quiet, and checks it:
#        390 and 1280 px wide, light and dark: axe-core (@axe-core/playwright,
#          _axe.mjs: wcag2a, wcag2aa, wcag21a, wcag21aa, wcag22aa and
#          best-practice);
#        320 px wide, light: reflow, no sideways scroll (WCAG 1.4.10);
#        1280 px wide, light, forced colours (forcedColors: 'active'): each
#          element a Tab reaches shows a visible focus indicator when focused,
#          in the engines that force the colours (Chromium and Firefox; WebKit's
#          Playwright emulates the media query alone);
#      then, once all three are done, it requests each same-origin link the
#      pages hold, once, with no browser (off-site links aren't: the step runs
#      offline). It runs on its own too, against any server and with a cookie
#      (a design direction's on `next dev`): its header has the call.
# The app's environment for 1 and 2 is tools/verify/smoke-env's NAME=value
# lines (its header says how; none by default, and the app runs as its own
# config says): when a value names {fixtures}, the Scenario driver's fixture
# server (_scenario_fixtures.mjs) starts before the build, on a port the OS
# picks free, serving the committed files of tools/verify/smoke-fixtures/, so
# what the app fetches is the same whatever the date or the live service holds
# (_server.sh's nx_step_env).
# The server and the fixture server are always stopped, the server's whole
# process group, before the step exits: on a pass, a finding, an error, and on
# INT, TERM or HUP.
#
# FACTORY_SMOKE_TIMEOUT (local.env; seconds, default 60) bounds each wait: the
# server's start, each page's load (each route in each view, in each engine),
# each page check and each link's request, and the stop of the server and the
# browser after TERM, when each is killed. FACTORY_BUILD_WAIT (local.env;
# seconds, default 900) bounds the wait for the build lock.
#
# Findings, on stdout (next's output goes to stderr). A page finding (console,
# page-error, response, request-failed, load, a11y, reflow, forced-colors)
# found everywhere its check ran reads as below, naming no engine or width; one
# found only in some engines names them, as a token after the <route>:
# chromium, firefox and webkit, in that order, those that report it, joined by
# commas (`smoke-a11y /contact firefox,webkit dark color-contrast ...`,
# `smoke-console / webkit: console error: ...`); one found only at some widths
# names them, as the token after that (or after the route): each width with px,
# smallest first, joined by commas (`smoke-a11y / 390px dark color-contrast
# ...`, `smoke-a11y /contact webkit 390px light ...`). So a finding the
# Baseline holds keeps matching while all three engines reproduce it at both of
# axe's widths:
#   package.json:1 smoke-build <message>       next build failed
#   package.json:1 smoke-build-lock <message>  another build held the build
#                                              lock past FACTORY_BUILD_WAIT
#   tools/verify/local.env:1 smoke-build-lock <message>
#                                              the lock's folder can't be made
#   package.json:1 smoke-start <message>       next start exited, or didn't
#                                              answer in time
#   ARCHITECTURE.md:<line> smoke-routes <why>  no page route to load: no
#                                              ARCHITECTURE.md, no `## Routes`
#                                              table, or no page line in it
#   package.json:1 smoke-console <route>: <message>
#                                              a console error on the page
#   package.json:1 smoke-page-error <route>: <message>
#                                              an uncaught error on the page
#   package.json:1 smoke-response <route>: <message>
#                                              the page, or a request it made,
#                                              answered other than 2xx (a
#                                              redirect is followed)
#   package.json:1 smoke-request-failed <route>: <message>
#                                              a request got no answer
#   package.json:1 smoke-load <route>: <message>
#                                              the page never loaded, or a
#                                              page check (axe, reflow,
#                                              forced colours, the link
#                                              reading) never finished on it
#   package.json:1 smoke-a11y <route> <scheme> <axe rule id> <target selector>: <help>
#                                              an axe violation on the page in
#                                              that scheme (light or dark), one
#                                              per selector, which names no
#                                              position, so a list's items are
#                                              one finding however many
#   package.json:1 smoke-reflow <route>: scrolls horizontally at 320px (<n>px wide[, widest <target selector>])
#                                              the page scrolls sideways 320 px
#                                              wide, naming the element reaching
#                                              furthest right that no ancestor
#                                              clips
#   package.json:1 smoke-forced-colors <route> <target selector>: no visible focus indicator in forced colours
#                                              an element a Tab reaches shows
#                                              no outline when focused, and
#                                              nothing near it changes (an
#                                              outline, border, box-shadow,
#                                              text-decoration, clip or size;
#                                              a colour where forced colours
#                                              are opted out of), in forced
#                                              colours
#   package.json:1 smoke-link <from route> <href> <status>
#                                              a same-origin link that answered
#                                              4xx or 5xx (or `failed: <reason>`)
#   tools/verify/smoke-env:<line> smoke-env '<line>' is not NAME=value, ...
#                                              a line that isn't NAME=value, or
#                                              names one of the steps' own
#                                              (NX_*, FACTORY_*)
#   tools/verify/smoke-env:<line> smoke-env {fixtures}/<path> names no fixture: ...
#                                              no file
#                                              tools/verify/smoke-fixtures/<path>
#   tools/verify/smoke-env:<line> smoke-env {fixtures}/<path> carries a query, ...
#                                              a query after it, which no smoke
#                                              fixture answers
#   tools/verify/smoke-env:<line> smoke-env the fixture server ...
#                                              the fixture server exited before
#                                              it listened (a seed file it
#                                              can't read), or didn't listen in
#                                              time; <line> is the first naming
#                                              {fixtures}
#   tools/verify/local.env:1 browser-missing <Engine> didn't start ...
#                                              a browser didn't start, one line
#                                              for each (Chromium, Firefox or
#                                              WebKit); then no page is loaded
#   tools/verify/local.env:1 smoke-setting     FACTORY_SMOKE_TIMEOUT isn't a whole
#                                              number of seconds, 1 to 999999, or
#                                              FACTORY_BUILD_WAIT one, 0 to 999999
#   (and node-missing or tool-missing, as _nextjs.sh has them)
# Every message leaves the server's port out (_smoke_page.mjs has the details). Exits 1 on any finding; but 75
# (NX_TRANSIENT) when the failure is no fault of the code, so verify --reuse
# never keeps it and runs the step again: the build lock held past the wait,
# next build finding another build running in the checkout (a smoke-build
# finding), or a request refused a connection (a finding naming
# ERR_CONNECTION_REFUSED or ECONNREFUSED, Firefox's NS_ERROR_CONNECTION_REFUSED,
# or WebKit's "Could not connect to <host>: Connection refused").
#
# A project with no pages (a library, an API alone) declares the step a no-op:
# it keeps this script as the marker line alone (factory/core/lib/steps.sh).
set -u

dir="$(dirname "${BASH_SOURCE[0]}")"
. "$dir/_nextjs.sh"
. "$dir/_server.sh"

if [ "$NX_LIMIT" -eq 0 ]; then
	echo "tools/verify/local.env:1 smoke-setting FACTORY_SMOKE_TIMEOUT is '${FACTORY_SMOKE_TIMEOUT:-}', not a number of seconds from 1 to 999999"
	exit 1
fi
tool_ready next || exit 1

tmp="$(mktemp -d)"
trap 'nx_stop; rm -rf "$tmp"' EXIT
nx_on_signal

"${NODE_BIN:-node}" "$dir/_routes.mjs" ARCHITECTURE.md smoke-routes > "$tmp/routes"
status=$?
if [ "$status" -ne 0 ]; then
	if [ "$status" -eq 1 ] && [ -s "$tmp/routes" ]; then
		cat "$tmp/routes"
	else
		echo "ARCHITECTURE.md:1 smoke-routes the route reader (tools/verify/_routes.mjs) exited $status (see stderr)"
	fi
	exit 1
fi
routes=()
while IFS= read -r route || [ -n "$route" ]; do
	route="${route%$'\r'}"
	[ -z "$route" ] || routes+=("$route")
done < "$tmp/routes"

# The app's environment (tools/verify/smoke-env), and the fixture server when
# it names one, before the build.
nx_step_env smoke-env "$tmp" || exit 1

nx_build
status=$?
if [ "$status" -ne 0 ]; then
	case "$NX_BUILD_WHY" in
		setting) echo "tools/verify/local.env:1 smoke-setting $NX_BUILD_MSG" ;;
		lock) echo "tools/verify/local.env:1 smoke-build-lock $NX_BUILD_MSG" ;;
		busy) echo "package.json:1 smoke-build-lock $NX_BUILD_MSG" ;;
		*) echo "package.json:1 smoke-build $NX_BUILD_MSG" ;;
	esac
	case "$NX_BUILD_WHY" in busy | collision) exit "$NX_TRANSIENT" ;; esac
	exit 1
fi

nx_start "$tmp/server.log"
nx_await "$tmp/server.log"
case $? in
	1)
		echo "package.json:1 smoke-start next start exited $NX_SERVER_STATUS before it answered (see stderr)"
		exit 1
		;;
	2)
		echo "package.json:1 smoke-start next start didn't answer within ${NX_LIMIT}s (FACTORY_SMOKE_TIMEOUT in tools/verify/local.env)"
		exit 1
		;;
esac

# The browser script closes its browsers on TERM, so nx_stop stops them alone.
nx_client 0 "${NODE_BIN:-node}" "$dir/_smoke_page.mjs" "http://127.0.0.1:$NX_PORT" "$NX_LIMIT" "${routes[@]}" > "$tmp/findings"
nx_client_wait
status=$?
cat "$tmp/server.log" >&2
cat "$tmp/findings"
if [ "$status" -ne 0 ] && [ ! -s "$tmp/findings" ]; then
	echo "package.json:1 smoke-load the browser script (tools/verify/_smoke_page.mjs) exited $status (see stderr)"
	exit 1
fi
[ -s "$tmp/findings" ] || exit 0
if grep -qE 'ERR_CONNECTION_REFUSED|ECONNREFUSED|NS_ERROR_CONNECTION_REFUSED|Could not connect to [^ ]*: Connection refused' "$tmp/findings"; then
	echo "smoke: a request was refused a connection: no fault of the code, so verify --reuse runs the step again" >&2
	exit "$NX_TRANSIENT"
fi
exit 1
