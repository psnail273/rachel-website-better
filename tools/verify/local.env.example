# Copy to tools/verify/local.env (gitignored) and set this machine's tool
# locations. Every verify run sources it. The versions are pinned in
# tools/verify/pins.

# Node 26.13.1. Empty means the node on PATH.
# Example: NODE_BIN=/home/me/.nvm/versions/node/v26.13.1/bin/node
NODE_BIN=

# pnpm. Empty means the pnpm on PATH. Any pnpm that reads package.json's
# packageManager field runs the pinned version; bootstrap fetches it once.
PNPM_BIN=

# Where Playwright keeps its browsers: bootstrap installs the smoke step's
# Chromium, Firefox and WebKit there, and smoke starts them from there. Empty
# means Playwright's own folder (~/.cache/ms-playwright on Linux).
PLAYWRIGHT_BROWSERS_PATH=

# The smoke step's limit, in seconds, on each of its waits: the server's start,
# the page's load and the server's stop; the Scenario driver's too, on the
# server's start and each stop. Empty means 60.
FACTORY_SMOKE_TIMEOUT=

# The build lock: smoke, the Scenario driver and playtest run next build one at a
# time on this machine, across every worktree and clone. FACTORY_BUILD_WAIT is
# how long, in seconds, a build waits for another to end (0 to 999999); empty
# means 900. FACTORY_BUILD_LOCK is the lock's path (a folder the build makes);
# empty means /tmp/factory-next-build.lock. Give every checkout on the machine
# the same one.
FACTORY_BUILD_WAIT=
FACTORY_BUILD_LOCK=

# The port the playtest step's start command names. Empty means 3000.
FACTORY_PLAYTEST_PORT=

# The port of the Scenario driver's fixture server (tools/verify/scenario-env's
# {fixtures}). It is fixed: while one Scenario run holds it, a second on this
# machine can't run (it says so); give that checkout another. Empty means 47391.
FACTORY_SCENARIO_FIXTURE_PORT=

# How many mutants the mutate step (StrykerJS) tests at once, each in its own
# Vitest worker. Empty means half the cores, at least 1.
STRYKER_JOBS=
