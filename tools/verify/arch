#!/usr/bin/env bash
# The Next.js arch step: ARCHITECTURE.md's sync check plus one check per
# `arch:<id>` (factory/core/lib/architecture.sh). Seeded into a project as
# tools/verify/arch; the Core runner runs it from the project root with
# FACTORY_CORE set.
#   bash tools/verify/arch
#
# Add a check: write a check_<name> function that prints `file:line message` per
# violation, and register it in the list at the bottom. The rule number comes
# from the ARCHITECTURE.md rule that cites the id, so a check never hardcodes one.
#
# The checks read the imports of the scoped code files (tools/verify/scope):
# dependency-cruiser (depcruise, the project's, pinned in tools/verify/pins)
# lists what each file imports once compiled, so an import of types alone
# counts as none, and resolves each as the build would (tsconfig.json's paths,
# extensions, index files); _arch_imports.mjs reads each file with TypeScript's
# parser for the line a finding names, and says what each check finds.
#
# Every import check reads dependency-cruiser's graph, so each registers as
# `runtime` (factory/core/lib/architecture.sh): it needs the installed
# node_modules. With FACTORY_ARCH_STATIC_ONLY=1 (the pre-commit hook, on a copy
# of the index that has no node_modules) the step skips the tool check and those
# checks, and runs only the sync check, which needs no tool; the full verify runs
# them all (#19).
#
# The lint-tags check makes each `lint:<rule>` tag true: for every tag on a
# rule's `Enforced by:` line (factory_arch_lint_tags), the lint step runs that
# rule. A tag naming one of the lint step's own checks (_lint_checks.awk's
# assertion-free and fixed-wait, as `awk -v list=1` prints them) holds as it
# stands; any other names an ESLint rule, which must be on (warn or error) for
# at least one file the lint step lints, as the installed ESLint's Node API
# (calculateConfigForFile) gives each file's config (_lint_tags.mjs), so a rule
# a config scopes to some files (only .tsx, only src/server/) holds. It asks the
# representative file first, the first non-test .ts or .tsx file in scope, under
# src/ when one is there, then the rest until every tag holds; a finding says
# why the rule is off for the representative file. With no such file, lint
# checks no TypeScript, and it asks nothing. It needs the installed ESLint, so
# static-only it doesn't run. It answers no arch:<id> tag: its findings carry
# the number of the rule whose tag is off.
#
# Findings, on stdout: `file:line R<n> message` for each violation, the sync
# check's arch-sync, the lint-tags check's `ARCHITECTURE.md:<line> R<n>
# lint:<rule> is not on: ...`, an arch-error when ESLint can't give a file's
# config, and (from _nextjs.sh) node-missing or tool-missing.
# dependency-cruiser's and ESLint's own output go to stderr. Exits 1 on any
# finding.
#
# Porting this step into a project made before input-zod: its sync check names
# the id no rule cites (arch-sync); copy the adapter's rule that cites it
# (factory/adapters/nextjs/ARCHITECTURE.md, the one whose Enforced by: names
# arch:input-zod) into the project's ARCHITECTURE.md under the next free number,
# add zod to package.json as the lint step's header says, then record what the
# check finds in old code: bash factory/core/baseline.sh add R<n>.
set -u

: "${FACTORY_CORE:?the arch step runs under the Core runner (factory/core/verify.sh)}"
. "$FACTORY_CORE/lib/steps.sh"
. "$FACTORY_CORE/lib/findings.sh"
. "$FACTORY_CORE/lib/architecture.sh"
dir="$(dirname "${BASH_SOURCE[0]}")"
. "$dir/_nextjs.sh"

ARCH_DOC=ARCHITECTURE.md
ARCH_TMP="$(mktemp -d)"
trap 'rm -rf "$ARCH_TMP"' EXIT

# arch_imports: _arch_imports.mjs's lines, `<check>\t<finding>`, worked out once
# (each check runs in a subshell, so the file is the cache). Exits non-zero, the
# reason on stderr, when dependency-cruiser or the reader fails.
arch_imports() {
	local status
	if [ ! -f "$ARCH_TMP/imports" ]; then
		# shellcheck disable=SC2086 # the extension list splits on purpose
		nx_files $NX_CODE_EXT > "$ARCH_TMP/scope"
		nx_tests < "$ARCH_TMP/scope" > "$ARCH_TMP/tests"
		if [ -s "$ARCH_TMP/scope" ]; then
			local -a files args=(--no-config --do-not-follow node_modules --exclude '^\.next/' --output-type json)
			mapfile -t files < "$ARCH_TMP/scope"
			[ ! -f tsconfig.json ] || args+=(--ts-config tsconfig.json)
			tool depcruise "${args[@]}" -- "${files[@]}" > "$ARCH_TMP/graph.json" 2> "$ARCH_TMP/depcruise.err"
			status=$?
			if [ "$status" -ne 0 ]; then
				cat "$ARCH_TMP/depcruise.err" >&2
				echo "arch: depcruise exited $status (above)" >&2
				return 1
			fi
		else
			echo '{"modules":[]}' > "$ARCH_TMP/graph.json"
		fi
		"${NODE_BIN:-node}" "$dir/_arch_imports.mjs" "$ARCH_TMP/graph.json" "$ARCH_TMP/scope" "$ARCH_TMP/tests" > "$ARCH_TMP/imports.new" || return 1
		mv "$ARCH_TMP/imports.new" "$ARCH_TMP/imports"
	fi
	cat "$ARCH_TMP/imports"
}

# imports_check <check>: that check's findings from arch_imports.
imports_check() {
	local lines
	lines="$(arch_imports)" || return 1
	printf '%s\n' "$lines" | awk -F'\t' -v c="$1" '$1 == c { print $2 }' | LC_ALL=C sort
}

check_client_server() { imports_check client-server; }
check_next_in_app() { imports_check next-in-app; }
check_fonts_local() { imports_check fonts-local; }
check_input_zod() { imports_check input-zod; }

# lint_tags_file: the file the lint-tags check asks ESLint about (see the
# header), or nothing.
lint_tags_file() {
	local -a code
	mapfile -t code < <(nx_files ts tsx | grep -vxF -f <(nx_files ts tsx | nx_tests))
	[ "${#code[@]}" -gt 0 ] || return 0
	printf '%s\n' "${code[@]}" | grep -m 1 '^src/' || printf '%s\n' "${code[0]}"
}

# check_lint_tags: the lint-tags check's findings, in full (see the header).
check_lint_tags() {
	local tags file status
	tags="$(factory_arch_lint_tags "$ARCH_DOC" | awk -v own="$(awk -v list=1 -f "$dir/_lint_checks.awk" < /dev/null)" '
		BEGIN { n = split(own, names, "\n"); for (i = 1; i <= n; i++) mine[names[i]] = 1 }
		!($3 in mine)
	')"
	[ -n "$tags" ] || return 0
	file="$(lint_tags_file)"
	[ -n "$file" ] || return 0
	tool_ready eslint || return 0
	# The representative file first, then every other file the lint step lints.
	{
		printf '%s\n' "$file"
		# shellcheck disable=SC2086 # the extension list splits on purpose
		nx_files $NX_CODE_EXT | grep -vxF -- "$file"
	} > "$ARCH_TMP/lint-files"
	printf '%s\n' "$tags" | "${NODE_BIN:-node}" "$dir/_lint_tags.mjs" "$ARCH_DOC" "$ARCH_TMP/lint-files" > "$ARCH_TMP/lint-tags"
	status=$?
	cat "$ARCH_TMP/lint-tags"
	[ "$status" -eq 0 ] ||
		factory_finding "$FACTORY_STEPS_DIR/arch" 1 arch-error "check lint-tags: ESLint could not give the config of a file it lints (see stderr)"
}

[ "${FACTORY_ARCH_STATIC_ONLY:-0}" = 1 ] || tool_ready depcruise || exit 1

factory_arch_check client-server check_client_server runtime
factory_arch_check next-in-app check_next_in_app runtime
factory_arch_check fonts-local check_fonts_local runtime
factory_arch_check input-zod check_input_zod runtime

bad=0
factory_arch_main "$ARCH_DOC" || bad=1
if [ "${FACTORY_ARCH_STATIC_ONLY:-0}" != 1 ] && [ -f "$ARCH_DOC" ]; then
	lint_findings="$(check_lint_tags)"
	if [ -n "$lint_findings" ]; then
		printf '%s\n' "$lint_findings"
		bad=1
	fi
fi
[ "$bad" -eq 0 ]
