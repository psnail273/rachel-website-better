#!/usr/bin/env bash
# The Scenario driver (factory/core/lib/scenarios.sh): runs the Scenario folder's
# scripts against the app, built and started as the smoke step starts it, with
# Playwright's test runner. Not a gate step; the Run runs it at a Feature's end:
#   bash factory/core/scenarios.sh
#
# A Scenario is one script in the folder (tools/verify/scenario-folder): a
# TypeScript or JavaScript file whose tests (`test(` from @playwright/test) play
# one behaviour through in a real browser and check what must hold. Its name is
# its path in the folder without its extension (`serve/after_a_miss` for
# scenarios/serve/after_a_miss.ts); its status is its worst test's, at that
# test's line (a file that declares no test is a helper, not a Scenario: a
# Scenario may import it). The `page` a test gets opens the started app: a path
# alone (page.goto("/")) is the app's own, as is `request`'s (request.get("/api/
# health")). It drives the app as a user would, by what the page shows:
#
#   import { expect, test } from "@playwright/test";
#
#   test("a tap serves one ball", async ({ page }) => {
#     await page.goto("/");
#     await page.getByRole("button", { name: "Serve" }).click();
#     await expect(page.getByText("Balls in play: 1")).toBeVisible();
#   });
#
# Find what to click and read by role, label and text (getByRole, getByLabel,
# getByText; getByTestId only for what the code already marks); check with
# expect's web-first assertions (toBeVisible, toHaveText, toHaveCount, toHaveURL),
# which wait for the page to settle, never with a fixed wait (waitForTimeout).
# A Scenario checks what the Spec says, by the names and words the app already
# has. It reaches the app only through the browser and HTTP: it imports no app
# code, and the app's state is the started server's, shared by every Scenario
# and kept between them, so each one starts from what it needs (a fresh page, a
# route that resets, a name of its own).
#
# What the app reads from outside (a feed, an API) and keeps on disk (a cache),
# the Scenarios set through tools/verify/scenario-env: its NAME=value lines are
# the app's environment for the run's next build, next start and Playwright runs,
# with {fixtures} in a value the driver's fixture server, http://127.0.0.1:<port>
# (_scenario_fixtures.mjs, started only when a value names it, at the fixed port
# FACTORY_SCENARIO_FIXTURE_PORT, default 47391; FACTORY_SCENARIO_FIXTURES holds
# it for the Scenarios), and {state} a folder of the run's own. Before each
# Scenario file the driver empties both: the fixture server serves nothing (each
# target answers 404) and the state folder is empty (a cache in it is gone). A
# Scenario then asks for the state it needs over HTTP, by the same env:
#
#   await request.put(process.env.FEED_URL!, {
#     data: ics, headers: { "content-type": "text/calendar" },
#   }); // GET FEED_URL answers ics from now on
#   await request.delete(process.env.FEED_URL!); // and 404 again
#
# and, when the app had rendered and cached the old state, through a route the
# app enables in the same env (a revalidation route) before it opens the page
# again. The server is not restarted between Scenario files.
#
# The driver lists the folder's files (git's, tracked or new, on disk; .ts, .tsx,
# .mts, .cts, .js, .jsx, .mjs, .cjs), keeps those that declare a test (as the
# test step finds one: _lint_checks.awk), installs the packages offline as
# prepare does (pnpm install --offline --frozen-lockfile: the Scenario run's own
# worktree starts with none), checks that Chromium starts, runs next build and
# next start (_server.sh, the smoke step's), then runs Playwright once
# per Scenario file (_scenarios.config.mjs: one worker, no retries, headless
# Chromium, Playwright's own timeouts), so a Scenario that doesn't load fails
# alone; _scenario_results.mjs reads each one's report. It starts the fixture
# server before next build, so the build and the server meet the same fixtures.
# Playwright's and next's output go to stderr. The server, the fixture server and
# each Playwright run's whole process group are always stopped before it exits:
# on a pass, a failure, an error, and on INT, TERM or HUP. FACTORY_SMOKE_TIMEOUT
# (local.env) bounds the server's start, the fixture server's, and each stop, as
# it does for smoke.
#
# The looks. Before any Scenario, with nothing served and the state folder
# empty, the driver holds each page route's look to its baseline: the page
# routes of ARCHITECTURE.md's `## Routes` table (_routes.mjs; none, and the run
# has no looks, saying so on stderr), each at 390 and 1280 px wide (the window
# 900 tall), light and dark, with reduced motion and animations stopped, the
# whole page, by Playwright's toHaveScreenshot (_scenario_looks.mjs; at most
# 0.2% of the pixels may differ, maxDiffPixelRatio 0.002 in
# _scenarios.config.mjs). A baseline is <folder>/looks/<name>.png, its name
# `<route-slug>-<width>-<scheme>` as the Board names its files (`home` for `/`,
# `therapy-about` for `/therapy/about`); the folder is the Scenario folder's, so
# the Editor neither reads nor writes it. A look is a results line of its own,
# before the Scenarios', named `looks/<name>`, at `<folder>/looks/<name>.png:1`:
#   PASS     the page looks as its baseline does
#   FAILURE  it doesn't: the expected, actual and diff images are copied to
#            <git-dir>/factory/looks/, which stderr names
#   SKIP     there is no baseline yet: the next Playtest the human approves
#            records it (stderr says so, naming the page as it is now,
#            copied to <git-dir>/factory/looks/); the run fails until then
#   ERROR    the page didn't load, or Playwright reported nothing on it
# A normal run never records a baseline: it never passes --update-snapshots,
# and the config says "none". Only the record mode does, which the Driver runs
# once the human approves a Playtest (factory-run's playtest.md):
#   bash tools/verify/scenarios record
# It reads tools/verify/local.env itself, runs the looks alone with
# --update-snapshots=changed (a baseline that is missing or differs is
# written), removes each baseline no route has now, and prints the looks'
# lines; it could not run them (exit 2) with no Scenario folder, named or in
# the checkout, or no page route.
#
# Prints one results line per look, then one per Scenario, in path order;
# nothing when there is no Scenario (no folder named, or no file in it declares
# a test). Exits 0 when every look and Scenario passed, 1 when one didn't, 2
# when it could not run them (the reason on stderr): no Core, Node or pnpm, a
# scenario-env line that isn't NAME=value, a FACTORY_SCENARIO_FIXTURE_PORT that
# isn't a port, the offline install failing, next or Playwright not installed,
# Chromium not starting, the fixture server not listening (another run holding
# its port), FACTORY_SMOKE_TIMEOUT not whole seconds, next build failing or next
# start not answering; or a usage error.
set -u

record=0
case "$#:${1:-}" in
	0:) ;;
	1:record) record=1 ;;
	*)
		echo "usage: bash tools/verify/scenarios [record]" >&2
		exit 2
		;;
esac
if [ "$record" -eq 1 ] && [ -f tools/verify/local.env ]; then
	set -a
	# shellcheck disable=SC1091 # the machine's own, gitignored
	. ./tools/verify/local.env
	set +a
fi
dir="$(dirname "${BASH_SOURCE[0]}")"
. "$dir/_nextjs.sh"
. "$dir/_server.sh"

# cannot <why>: the driver could not run the Scenarios.
cannot() {
	echo "scenarios: $*" >&2
	exit 2
}

if [ -z "$NX_SCENARIOS" ]; then
	[ "$record" -eq 0 ] || cannot "record: the project names no Scenario folder (tools/verify/scenario-folder), where the looks' baselines go"
	exit 0
fi
[ "$record" -eq 0 ] || [ -d "$NX_SCENARIOS" ] ||
	cannot "record: this checkout has no $NX_SCENARIOS/ (an issue's worktree leaves it out): record from a checkout of dev (factory-run's playtest.md)"

tmp="$(mktemp -d)"
trap 'nx_stop; rm -rf "$tmp"' EXIT
nx_on_signal

# The Scenarios: the folder's code files that declare a test.
git -c core.quotepath=off ls-files --cached --others --exclude-standard -- "$NX_SCENARIOS/" |
	while IFS= read -r f; do
		case " $NX_CODE_EXT " in *" ${f##*.} "*) [ -f "$f" ] && printf '%s\n' "$f" ;; esac
	done | LC_ALL=C sort -u > "$tmp/files"
mapfile -t files < "$tmp/files"
scenarios=()
for f in "${files[@]}"; do
	[ -n "$(awk -v counts=1 -v declares=1 -v path="$f" -f "$dir/_lint_checks.awk" < "$f")" ] && scenarios+=("$f")
done
[ "${#scenarios[@]}" -gt 0 ] || [ "$record" -eq 1 ] || exit 0

[ "$NX_LIMIT" -ne 0 ] ||
	cannot "FACTORY_SMOKE_TIMEOUT is '${FACTORY_SMOKE_TIMEOUT:-}', not a number of seconds from 1 to 999999 (tools/verify/local.env)"

# The app's environment for the run (tools/verify/scenario-env), its
# placeholders filled: the fixture server's origin and the state folder.
env_file="$dir/scenario-env"
fixtures_port="${FACTORY_SCENARIO_FIXTURE_PORT:-47391}"
fixtures_origin="http://127.0.0.1:$fixtures_port"
mkdir -p "$tmp/fixtures" "$tmp/state"
nx_env_read "$env_file" ||
	cannot "tools/verify/scenario-env:$NX_ENV_BAD: '$NX_ENV_LINE' is not NAME=value, NAME in capitals, digits and _, and none of the driver's own (NX_*, FACTORY_*)"
wants_fixtures="$NX_ENV_FIXTURES"
if [ "$wants_fixtures" -eq 1 ]; then
	case "$fixtures_port" in
		'' | *[!0-9]* | 0* | ??????*) port_ok=0 ;;
		*) port_ok=$((fixtures_port <= 65535)) ;;
	esac
	[ "$port_ok" -eq 1 ] ||
		cannot "FACTORY_SCENARIO_FIXTURE_PORT is '$fixtures_port', not a port from 1 to 65535 (tools/verify/local.env)"
fi

if ! { node_ready && pnpm_ready; } > "$tmp/ready"; then
	sed 's/^[^ ]* [^ ]* /scenarios: /' "$tmp/ready" >&2
	exit 2
fi
pnpm install --offline --frozen-lockfile >&2
status=$?
[ "$status" -eq 0 ] ||
	cannot "pnpm install --offline --frozen-lockfile exited $status (above); run bash tools/verify/bootstrap, the step allowed the network, then the Scenarios again"
for t in next playwright; do
	if ! tool_ready "$t" > "$tmp/ready"; then
		sed 's/^[^ ]* [^ ]* /scenarios: /' "$tmp/ready" >&2
		exit 2
	fi
done

# The page routes the looks check; none, and there are no looks.
routes=()
"${NODE_BIN:-node}" "$dir/_routes.mjs" ARCHITECTURE.md scenarios-routes > "$tmp/routes"
status=$?
if [ "$status" -eq 0 ]; then
	while IFS= read -r route || [ -n "$route" ]; do
		route="${route%$'\r'}"
		[ -z "$route" ] || routes+=("$route")
	done < "$tmp/routes"
else
	[ "$record" -eq 0 ] || cannot "record: no page route to record a look of: $(cat "$tmp/routes")"
	echo "scenarios: no looks: $(cat "$tmp/routes")" >&2
fi

if ! "${NODE_BIN:-node}" --input-type=module -e '
	import { chromium } from "@playwright/test";
	const browser = await chromium.launch({ headless: true });
	await browser.close();
' > "$tmp/browser.log" 2>&1 < /dev/null; then
	cat "$tmp/browser.log" >&2
	cannot "Chromium didn't start (above); run bash tools/verify/bootstrap, which installs it into PLAYWRIGHT_BROWSERS_PATH (tools/verify/local.env), and if it names missing system libraries: pnpm exec playwright install-deps chromium"
fi

# The fixture server, when scenario-env names it: up (its own line says so)
# before next build, or the driver can't run them.
if [ "$wants_fixtures" -eq 1 ]; then
	nx_fixtures_up "$fixtures_port" "$tmp/fixtures" "$tmp/fixtures.log"
	case $? in
		1) cannot "the fixture server exited $NX_FIXTURES_STATUS before it listened on 127.0.0.1:$fixtures_port (above): another Scenario run may hold the port; FACTORY_SCENARIO_FIXTURE_PORT in tools/verify/local.env names another" ;;
		2) cannot "the fixture server didn't listen on 127.0.0.1:$fixtures_port within ${NX_LIMIT}s (FACTORY_SMOKE_TIMEOUT in tools/verify/local.env)" ;;
	esac
	export FACTORY_SCENARIO_FIXTURES="$fixtures_origin"
fi
nx_env_export "$tmp/state"

nx_build
status=$?
[ "$status" -eq 0 ] || cannot "next build exited $status (above)"
nx_start "$tmp/server.log"
nx_await "$tmp/server.log"
case $? in
	1) cannot "next start exited $NX_SERVER_STATUS before it answered (above)" ;;
	2) cannot "next start didn't answer within ${NX_LIMIT}s (FACTORY_SMOKE_TIMEOUT in tools/verify/local.env)" ;;
esac

root="$(pwd -P)"
verify="$(cd "$dir" && pwd -P)"
config="$verify/_scenarios.config.mjs"
export FACTORY_SCENARIO_ORIGIN="http://127.0.0.1:$NX_PORT"
: > "$tmp/results"
bad=0

# The looks: one Playwright run of _scenario_looks.mjs, before any Scenario.
looks="$NX_SCENARIOS/looks"
if [ "${#routes[@]}" -gt 0 ]; then
	shots="$(git rev-parse --absolute-git-dir)/factory/looks"
	rm -rf "$shots"
	# Each look's name, <route-slug>-<width>-<scheme>, as _scenario_looks.mjs
	# titles its test.
	mapfile -t slugs < <(FACTORY_ROUTES_MJS="$verify/_routes.mjs" "${NODE_BIN:-node}" --input-type=module -e '
		const { pathToFileURL } = await import("node:url");
		const { routeSlug } = await import(pathToFileURL(process.env.FACTORY_ROUTES_MJS).href);
		for (const path of process.argv.slice(1)) console.log(routeSlug(path));
	' "${routes[@]}")
	names=()
	for width in 390 1280; do
		for scheme in light dark; do
			for slug in "${slugs[@]}"; do
				names+=("$slug-$width-$scheme")
			done
		done
	done
	find "$tmp/fixtures" "$tmp/state" -mindepth 1 -delete
	FACTORY_SCENARIO_ROUTES="$(printf '%s\n' "${routes[@]}")"
	export FACTORY_SCENARIO_DIR="$verify" FACTORY_SCENARIO_FILE="$verify/_scenario_looks.mjs" \
		FACTORY_SCENARIO_LOOKS="$root/$looks" FACTORY_SCENARIO_ROUTES \
		FACTORY_SCENARIO_REPORT="$tmp/report-looks.json" FACTORY_SCENARIO_OUTPUT="$tmp/output-looks"
	update=()
	[ "$record" -eq 0 ] || update=(--update-snapshots=changed)
	nx_client 1 tool playwright test --config "$config" "${update[@]}" >&2
	nx_client_wait
	status=$?
	declare -A found=()
	if [ -s "$FACTORY_SCENARIO_REPORT" ] &&
		"${NODE_BIN:-node}" "$dir/_scenario_results.mjs" --each "$FACTORY_SCENARIO_REPORT" > "$tmp/looks"; then
		while IFS=$'\t' read -r verdict name; do
			[ -z "$name" ] || found["$name"]="$verdict"
		done < "$tmp/looks"
	else
		echo "scenarios: looks: Playwright exited $status without a report it could read (above)" >&2
	fi
	unset FACTORY_SCENARIO_LOOKS FACTORY_SCENARIO_ROUTES
	while IFS= read -r name; do
		verdict="${found["$name"]:-ERROR}"
		printf 'looks/%s\t%s\t%s\n' "$name" "$verdict" "$looks/$name.png:1" >> "$tmp/results"
		case "$verdict" in
			SKIP)
				mkdir -p "$shots"
				find "$FACTORY_SCENARIO_OUTPUT" -type f -name "$name-actual.png" -exec cp {} "$shots/" \;
				echo "scenarios: looks/$name: no baseline at $looks/$name.png: the next Playtest the human approves records it (bash tools/verify/scenarios record); the page now: $shots/$name-actual.png" >&2
				;;
			FAILURE)
				mkdir -p "$shots"
				find "$FACTORY_SCENARIO_OUTPUT" -type f -name "$name-*.png" -exec cp {} "$shots/" \;
				echo "scenarios: looks/$name: the page doesn't look as its baseline $looks/$name.png does: see $shots/$name-expected.png, -actual.png and -diff.png" >&2
				;;
		esac
		[ "$verdict" = PASS ] || bad=1
	done < <(printf '%s\n' "${names[@]}" | LC_ALL=C sort)
fi
if [ "$record" -eq 1 ]; then
	# Each baseline no route has now goes.
	for f in "$looks"/*.png; do
		[ -f "$f" ] || continue
		name="$(basename "$f" .png)"
		case " ${names[*]} " in *" $name "*) ;; *)
			rm -f "$f"
			echo "scenarios: record: removed $f: no route has that look now" >&2
			;;
		esac
	done
	cat "$tmp/server.log" >&2
	cat "$tmp/results"
	exit "$bad"
fi

export FACTORY_SCENARIO_DIR="$root/$NX_SCENARIOS"
for i in "${!scenarios[@]}"; do
	f="${scenarios[i]}"
	# Each Scenario file starts with nothing served and an empty state folder.
	find "$tmp/fixtures" "$tmp/state" -mindepth 1 -delete
	export FACTORY_SCENARIO_FILE="$root/$f" FACTORY_SCENARIO_REPORT="$tmp/report-$i.json" FACTORY_SCENARIO_OUTPUT="$tmp/output-$i"
	nx_client 1 tool playwright test --config "$config" >&2
	nx_client_wait
	status=$?
	if [ -s "$FACTORY_SCENARIO_REPORT" ] &&
		line="$("${NODE_BIN:-node}" "$dir/_scenario_results.mjs" "$FACTORY_SCENARIO_REPORT" "$FACTORY_SCENARIO_FILE")"; then
		verdict="${line%%$'\t'*}"
		at="${line#*$'\t'}"
	else
		echo "scenarios: $f: Playwright exited $status without a report it could read (above)" >&2
		verdict=ERROR
		at=1
	fi
	name="${f#"$NX_SCENARIOS"/}"
	printf '%s\t%s\t%s\n' "${name%.*}" "$verdict" "$f:$at" >> "$tmp/results"
	[ "$verdict" = PASS ] || bad=1
done
cat "$tmp/server.log" >&2
cat "$tmp/results"
exit "$bad"
