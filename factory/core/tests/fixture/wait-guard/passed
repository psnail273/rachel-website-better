while kill -0 "$pid" 2> /dev/null; do sleep 2; done
== -u from a variable: it can't be known
pgrep -u "$USER" -f foo
== -u naming another user
pgrep -u factory-no-such-user -f 'postgres: checkpointer'
== -U naming another user, attached
pgrep -Ufactory-no-such-user -f foo
== --euid naming other users
pgrep --euid=factory-no-such-user,factory-other -f foo
== -G naming another group
pgrep -G factory-no-such-group -f foo
== -O: the shell, started just now, is younger
pkill -O 3600 -f 'next dev'
== -O attached, in a cluster
pgrep -afO3600 node
