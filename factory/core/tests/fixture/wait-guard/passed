pgrep -f foo -v
== -P selects by parent
pgrep -P "$pid" -f foo
== anchored at the start: the shell's command line starts elsewhere
pgrep -f "^node"
== anchored at the end: the shell's command line ends elsewhere
pgrep -f "foo$"
