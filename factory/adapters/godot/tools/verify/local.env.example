# Copy to tools/verify/local.env (gitignored) and set this machine's tool
# locations. Every verify run sources it. The versions are pinned in
# tools/verify/pins.

# Godot 4.7.1. No default: a step that runs Godot fails while this is empty.
# Example: GODOT_BIN=/c/Tools/Godot_v4.7.1-stable_win64.exe
GODOT_BIN=

# GDQuest gdscript-formatter 0.27.0. Empty means the one on PATH.
GDSCRIPT_FORMATTER=

# gdmutant 0.1.4, for the mutate step. Empty means the one on PATH.
GDMUTANT_BIN=
# How many mutants the mutate step tests at once, each in its own copy of the
# project. Empty means half the cores; it is never below 2.
GDMUTANT_JOBS=
