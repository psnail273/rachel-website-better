#!/usr/bin/env bash
# The Godot arch step: ARCHITECTURE.md's sync check plus one check per `arch:<id>`.
# Seeded into a project as tools/verify/arch; the Core runner runs it from the
# project root with FACTORY_CORE set.
#
# Add a check: write a check_<name> function that prints `file:line message` per
# violation, and register it in the list at the bottom. The rule number comes from
# the ARCHITECTURE.md rule that cites the id, so a check never hardcodes one.
# A check that runs Godot (the probe below) is registered with a third word,
# `runtime` (#99: pre-commit runs only the others).
#
# The grep checks read GDScript with comment lines and trailing comments removed
# (gd_code), so a commented-out line never counts. Files checked: what git tracks
# or would track (ignored files such as prototypes/ are left out), minus
# ARCH_SKIP and the Scenario folder (_gdscript.sh). Product scripts and scenes are those files' .gd scripts and .tscn
# scenes that aren't tests, by tools/verify/test-paths.
set -u

: "${FACTORY_CORE:?the arch step runs under the Core runner (factory/core/verify.sh)}"
. "$FACTORY_CORE/lib/steps.sh"
. "$FACTORY_CORE/lib/findings.sh"
. "$FACTORY_CORE/lib/architecture.sh"
. "$FACTORY_CORE/lib/brief.sh"
. "$(dirname "${BASH_SOURCE[0]}")/_gdscript.sh"

# Paths no check reads: third-party code, the vendored factory, the step scripts.
ARCH_SKIP='^(addons|factory|tools)/'
RATCHET="$FACTORY_STEPS_DIR/ratchet"
TOOL_ALLOWLIST="$RATCHET/tool_scripts.txt"
VISUAL_NEW_ALLOWLIST="$RATCHET/visual_new.txt"
RUN_MODE_ALLOWLIST="$RATCHET/run_mode.txt"

# --- inputs -----------------------------------------------------------------

# arch_files: every checked file, one path per line, sorted.
arch_files() {
	if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
		git ls-files --cached --others --exclude-standard
	else
		find . -type f -not -path './.git/*' -not -path './.godot/*' | sed 's|^\./||'
	fi | tr -d '\r' | grep -Ev "$ARCH_SKIP" |
		awk -v skip="${GD_SCENARIOS:+$GD_SCENARIOS/}" 'skip == "" || index($0, skip) != 1' | LC_ALL=C sort -u
}

# TESTS_RE: one extended regex for the test files: the globs of
# tools/verify/test-paths (the Core's glob syntax), or tests/** when it holds
# none (prepare reports a missing one). Stop if that fails: an empty regex makes
# grep -Ev '' drop every file, and the step would pass having checked nothing.
TESTS_RE="$(gd_tests_regex)" || exit 2

# gd_scripts: every checked .gd file. product_scripts: those that aren't tests.
gd_scripts() { arch_files | grep -E '\.gd$'; }
product_scripts() { gd_scripts | grep -Ev "$TESTS_RE"; }

# GD_STRIP: an awk function that cuts a GDScript line's comment, keeping any `#`
# inside a string, so "../x" and "/root/" in node paths still count.
GD_STRIP='
function code_part(s,   i, c, q, out) {
	q = ""; out = ""
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (q != "") {
			out = out c
			if (c == "\\") { i++; out = out substr(s, i, 1) }
			else if (c == q) q = ""
			continue
		}
		if (c == "\"" || c == "\x27") { q = c; out = out c; continue }
		if (c == "#") break
		out = out c
	}
	return out
}'

# gd_code <file...>: `file<TAB>line<TAB>code` for each line with code left once
# its comment is cut. Comment lines and blank lines print nothing.
gd_code() {
	[ "$#" -eq 0 ] && return 0
	awk "$GD_STRIP"'
		FNR == 1 { file = FILENAME }
		{
			sub(/\r$/, "")
			code = code_part($0)
			if (code ~ /^[ \t]*$/) next
			gsub(/\t/, " ", code)
			print file "\t" FNR "\t" code
		}
	' "$@"
}

# ratchet_entries <file>: the paths a ratchet file lists, as `line<TAB>path`.
# A missing file lists nothing; blank lines and # comments are skipped.
ratchet_entries() {
	[ -f "$1" ] || return 0
	tr -d '\r' < "$1" | awk '/^[ \t]*(#|$)/ { next } { print NR "\t" $1 }'
}

# --- R1 no-autoloads ----------------------------------------------------------

check_no_autoloads() {
	[ -f project.godot ] || return 0
	tr -d '\r' < project.godot | awk '
		/^\[/ { in_autoload = ($0 == "[autoload]"); next }
		in_autoload && /^[A-Za-z_][A-Za-z0-9_]*=/ {
			name = substr($0, 1, index($0, "=") - 1)
			print "project.godot:" NR " autoload " name "; pass it down from the scene that owns it"
		}
	'
}

# --- R6 no-reach-up -----------------------------------------------------------

check_no_reach_up() {
	local files
	mapfile -t files < <(product_scripts)
	gd_code "${files[@]}" | awk -F'\t' '
		{
			code = $3; what = ""
			if (code ~ /(^|[^A-Za-z0-9_])get_parent([^A-Za-z0-9_]|$)/) what = "get_parent"
			else if (code ~ /(^|[^A-Za-z0-9_])owner\./) what = "owner."
			else if (code ~ /\.\.\//) what = "../"
			else if (code ~ /get_tree\(\)\.root([^A-Za-z0-9_]|$)/) what = "get_tree().root"
			else if (code ~ /\/root\//) what = "/root/"
			else if (code ~ /(^|[^A-Za-z0-9_])current_scene([^A-Za-z0-9_]|$)/) what = "current_scene"
			if (what != "") print $1 ":" $2 " reaches up the tree with " what "; have its parent pass it down instead"
		}
	'
}

# --- R7 no-warning-ignore -----------------------------------------------------

check_no_warning_ignore() {
	local files
	mapfile -t files < <(gd_scripts)
	# String literals are emptied first, so a mention inside one is not a finding.
	gd_code "${files[@]}" | awk -F'\t' '
		{
			code = $3
			gsub(/"([^"\\]|\\.)*"/, "\"\"", code)
			gsub(/\047([^\047\\]|\\.)*\047/, "\047\047", code)
		}
		match(code, /@warning_ignore[a-z_]*/) {
			print $1 ":" $2 " suppresses a warning with " substr(code, RSTART, RLENGTH) "; fix the code instead"
		}
	'
}

# --- R9 naming ----------------------------------------------------------------

# Godot's own files: scripts, scenes, resources and shaders. Assets keep the
# names they came with.
NAMED_FILES='\.(gd|tscn|scn|tres|res|gdshader)$'

check_naming() {
	arch_files | grep -E "$NAMED_FILES" | awk -F/ '
		function snake(s) { return s ~ /^[a-z0-9]+(_[a-z0-9]+)*$/ }
		{
			dir = ""
			for (i = 1; i < NF; i++) {
				dir = (dir == "" ? $i : dir "/" $i)
				if (!snake($i) && !(dir in told)) {
					told[dir] = 1
					print dir ":1 folder " $i " is not snake_case"
				}
			}
			stem = $NF
			sub(/\..*$/, "", stem)
			if (!snake(stem)) print $0 ":1 file " $NF " is not snake_case"
		}
	'
	local scenes
	mapfile -t scenes < <(arch_files | grep -E '\.tscn$')
	[ "${#scenes[@]}" -eq 0 ] && return 0
	awk '
		FNR == 1 { file = FILENAME }
		match($0, /^\[node name="[^"]*"/) {
			name = substr($0, RSTART + 12, RLENGTH - 13)
			if (name !~ /^[A-Z][A-Za-z0-9]*$/) print file ":" FNR " node " name " is not PascalCase"
		}
	' "${scenes[@]}"
}

# --- R10 third-party ----------------------------------------------------------

check_third_party() {
	local f
	arch_files | while IFS= read -r f; do
		case "$f" in
			plugin.cfg | */plugin.cfg) echo "$f:1 is a Godot plugin; third-party code goes under addons/" ;;
			*.gdextension) echo "$f:1 is a GDExtension; third-party code goes under addons/" ;;
		esac
	done
	local files
	mapfile -t files < <(arch_files | grep -E '\.(gd|gdshader|cs)$')
	[ "${#files[@]}" -eq 0 ] && return 0
	awk '
		FNR == 1 { file = FILENAME }
		FNR <= 10 && /^[ \t]*(#|\/\/)/ && (/SPDX-License-Identifier/ || /[Cc]opyright/) {
			print file ":" FNR " carries a licence header; third-party code goes under addons/"
			nextfile
		}
	' "${files[@]}"
}

# --- R11 tool-allowlist -------------------------------------------------------

check_tool_allowlist() {
	local files allowed tools
	mapfile -t files < <(gd_scripts)
	tools="$(gd_code "${files[@]}" | awk -F'\t' '$3 ~ /^[ \t]*@tool([^A-Za-z0-9_]|$)/ { print $1 "\t" $2 }')"
	allowed="$(ratchet_entries "$TOOL_ALLOWLIST")"
	printf '%s\n' "$tools" | awk -F'\t' -v allowed="$allowed" -v list="$TOOL_ALLOWLIST" '
		BEGIN { n = split(allowed, a, "\n"); for (i = 1; i <= n; i++) { split(a[i], e, "\t"); if (e[2] != "") ok[e[2]] = 1 } }
		$1 != "" && !($1 in ok) { print $1 ":" $2 " is a @tool script not on " list "; adding one is a declared Deviation" }
	'
	printf '%s\n' "$allowed" | awk -F'\t' -v tools="$tools" -v list="$TOOL_ALLOWLIST" '
		BEGIN { n = split(tools, t, "\n"); for (i = 1; i <= n; i++) { split(t[i], e, "\t"); if (e[1] != "") is_tool[e[1]] = 1 } }
		$2 != "" && !($2 in is_tool) { print list ":" $1 " lists " $2 ", which is not a @tool script; remove it" }
	'
}

# --- R13 no-tunable-consts ----------------------------------------------------

# A const is a tunable when its value is a number or a colour/vector literal. A
# `## invariant` doc comment above it, or trailing it, exempts it.
check_no_tunable_consts() {
	local files
	mapfile -t files < <(product_scripts)
	[ "${#files[@]}" -eq 0 ] && return 0
	awk "$GD_STRIP"'
		FNR == 1 { file = FILENAME; invariant = 0 }
		{
			sub(/\r$/, "")
			if ($0 ~ /^[ \t]*##/) { if ($0 ~ /^[ \t]*##[ \t]*invariant([^A-Za-z0-9_]|$)/) invariant = 1; next }
			if ($0 ~ /^[ \t]*#/) next
			code = code_part($0)
			marked = invariant || substr($0, length(code) + 1) ~ /^[ \t]*##[ \t]*invariant([^A-Za-z0-9_]|$)/
			invariant = 0
			if (!match(code, /^[ \t]*(static[ \t]+)?const[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) next
			head = substr(code, RSTART, RLENGTH)
			name = head; sub(/^.*const[ \t]+/, "", name)
			eq = index(code, "=")
			if (eq == 0 || marked) next
			value = substr(code, eq + 1); sub(/^[ \t]+/, "", value)
			if (value ~ /^[-+(]*[0-9]/ || value ~ /^(Color|Vector[234]i?|Rect2i?)\(/ || value ~ /^Color\.[A-Z_]+[ \t]*$/)
				print file ":" FNR " const " name " is a tunable; export it on GameConfig or a scene node, or mark it ## invariant"
		}
	' "${files[@]}"
}

# --- R14 no-visual-new --------------------------------------------------------

# Engine node types that draw or lay out. A script class is visual when its
# extends chain reaches one of these.
VISUAL_TYPES='CanvasItem CanvasLayer CanvasGroup CanvasModulate BackBufferCopy
Node2D Sprite2D AnimatedSprite2D Line2D Polygon2D MeshInstance2D MultiMeshInstance2D
Area2D StaticBody2D AnimatableBody2D RigidBody2D CharacterBody2D PhysicalBone2D
CollisionShape2D CollisionPolygon2D Camera2D Marker2D Path2D PathFollow2D
RayCast2D ShapeCast2D RemoteTransform2D Skeleton2D Bone2D TileMap TileMapLayer
Parallax2D ParallaxBackground ParallaxLayer CPUParticles2D GPUParticles2D
PointLight2D DirectionalLight2D LightOccluder2D NavigationRegion2D
VisibleOnScreenNotifier2D VisibleOnScreenEnabler2D TouchScreenButton
Control Container BoxContainer HBoxContainer VBoxContainer GridContainer FlowContainer
HFlowContainer VFlowContainer CenterContainer MarginContainer PanelContainer
ScrollContainer SplitContainer HSplitContainer VSplitContainer TabContainer
AspectRatioContainer SubViewportContainer FoldableContainer GraphElement GraphNode GraphFrame GraphEdit
Label RichTextLabel Button CheckBox CheckButton LinkButton MenuButton OptionButton
ColorPickerButton TextureButton BaseButton ColorRect TextureRect NinePatchRect
Panel ReferenceRect LineEdit TextEdit CodeEdit SpinBox Slider HSlider VSlider
ScrollBar HScrollBar VScrollBar ProgressBar TextureProgressBar Range Separator
HSeparator VSeparator ItemList Tree TabBar MenuBar ColorPicker VideoStreamPlayer
Node3D VisualInstance3D GeometryInstance3D MeshInstance3D MultiMeshInstance3D
Sprite3D AnimatedSprite3D Label3D CSGShape3D Camera3D Decal FogVolume
GPUParticles3D CPUParticles3D OmniLight3D SpotLight3D DirectionalLight3D'

check_no_visual_new() {
	local files allowed
	mapfile -t files < <(product_scripts)
	[ "${#files[@]}" -eq 0 ] && return 0
	allowed="$(ratchet_entries "$VISUAL_NEW_ALLOWLIST")"
	local found
	found="$(
		awk -v builtin="$VISUAL_TYPES" -v allowed="$allowed" "$GD_STRIP"'
			BEGIN {
				n = split(builtin, b, /[ \t\n]+/)
				for (i = 1; i <= n; i++) if (b[i] != "") visual[b[i]] = 1
				n = split(allowed, a, "\n")
				for (i = 1; i <= n; i++) { split(a[i], e, "\t"); if (e[2] != "") ok[e[2]] = 1 }
			}
			FNR == 1 { file = FILENAME }
			{
				sub(/\r$/, "")
				code = code_part($0)
				if (match(code, /^class_name[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) { t = substr(code, RSTART, RLENGTH); sub(/^class_name[ \t]+/, "", t); cls[file] = t }
				if (match(code, /^extends[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) { t = substr(code, RSTART, RLENGTH); sub(/^extends[ \t]+/, "", t); ext[file] = t }
				rest = code
				while (match(rest, /[A-Z][A-Za-z0-9_]*\.new\(/)) {
					nf++; nfile[nf] = file; nline[nf] = FNR; ntype[nf] = substr(rest, RSTART, RLENGTH - 5)
					rest = substr(rest, RSTART + RLENGTH)
				}
			}
			function is_visual(t,   hops) {
				for (hops = 0; t != "" && hops < 50; hops++) {
					if (t in visual) return 1
					t = (t in parent) ? parent[t] : ""
				}
				return 0
			}
			END {
				for (f in cls) if (f in ext) parent[cls[f]] = ext[f]
				for (i = 1; i <= nf; i++) {
					if (!is_visual(ntype[i])) continue
					print "used\t" nfile[i]
					if (!(nfile[i] in ok)) print "finding\t" nfile[i] ":" nline[i] " " ntype[i] ".new() builds a visual node in code; instance it from its own scene"
				}
			}
		' "${files[@]}"
	)"
	printf '%s\n' "$found" | awk -F'\t' '$1 == "finding" { print $2 }'
	printf '%s\n' "$allowed" | awk -F'\t' -v found="$found" -v list="$VISUAL_NEW_ALLOWLIST" '
		BEGIN { n = split(found, f, "\n"); for (i = 1; i <= n; i++) { split(f[i], e, "\t"); if (e[1] == "used") used[e[2]] = 1 } }
		$2 != "" && !($2 in used) { print list ":" $1 " lists " $2 ", which builds no visual node in code; remove it" }
	'
}

# --- run-mode -------------------------------------------------------------------

# Calls that tell product code how it was started: command-line arguments, the
# environment, the build, the editor, the debugger or the display server. A game
# that branches on them behaves one way under its tests and smoke runs and
# another for players. OS.has_feature counts only with a run-mode tag as its
# first argument; the platform tags (android, mobile, web...) are fine.
# Engine.is_editor_hint is fine in a @tool script. The check reads whole
# statements (lines joined while a bracket stays open or a line ends in a
# backslash), with comments and the insides of strings blanked, a
# triple-quoted string over many lines too.
RUN_MODE_CALLS='OS[.](get_cmdline_args|get_cmdline_user_args|is_debug_build|is_stdout_verbose|get_environment|has_environment|set_environment|unset_environment|has_feature)|DisplayServer[.]get_name|Engine[.](is_editor_hint|is_embedded_in_editor)|EngineDebugger[.]is_active'
RUN_MODE_TAGS='editor|editor_hint|editor_runtime|template|debug|release|standalone|movie'

check_run_mode() {
	local files allowed found=""
	mapfile -t files < <(product_scripts)
	allowed="$(ratchet_entries "$RUN_MODE_ALLOWLIST")"
	if [ "${#files[@]}" -gt 0 ]; then
		found="$(
			awk -v calls="$RUN_MODE_CALLS" -v tags="$RUN_MODE_TAGS" '
				# A dot may have blanks around it, as a line split after it leaves.
				BEGIN { gsub(/\[\.\]/, "[ \t]*[.][ \t]*", calls); call_re = "[^A-Za-z0-9_.](" calls ")[ \t]*\\("; tag_re = "^(" tags ")$" }
				# blank(s): s at its own length, its comment and the insides of its
				# strings made blanks (the quotes kept); a triple-quoted string left
				# open (tq) carries on into the next line.
				function blank(s,   i, c, q, out, n) {
					q = tq; out = ""; n = length(s)
					for (i = 1; i <= n; i++) {
						c = substr(s, i, 1)
						if (q != "") {
							if (c == "\\") { out = out (i < n ? "  " : " "); i++; continue }
							if ((length(q) == 3) ? (substr(s, i, 3) == q) : (c == q)) { out = out q; i += length(q) - 1; q = ""; continue }
							out = out " "; continue
						}
						if (c == "\"" || c == "\x27") {
							if (substr(s, i, 3) == c c c) { q = c c c; out = out q; i += 2; continue }
							q = c; out = out c; continue
						}
						if (c == "#") { for (; i <= n; i++) out = out " "; break }
						out = out c
					}
					tq = (length(q) == 3) ? q : ""
					return out
				}
				function depth(s,   t) { t = s; return gsub(/[([{]/, "", t) - gsub(/[)\]}]/, "", s) }
				# run_tag: true when the call whose arguments start at st[pos] has a
				# run-mode tag, as a string literal, for its first argument.
				function run_tag(pos,   i, c, d, a, q1, q2) {
					d = 0
					for (i = pos; i <= length(st); i++) {
						c = substr(st, i, 1)
						if (c ~ /[([{]/) d++
						else if (c ~ /[)\]}]/) { if (d == 0) break; d-- }
						else if (c == "," && d == 0) break
					}
					a = substr(st, pos, i - pos)
					if (a !~ /^[ \t]*&?["\x27] *["\x27][ \t]*$/) return 0
					q1 = match(a, /["\x27]/)
					q2 = q1 + match(substr(a, q1 + 1), /["\x27]/)
					return substr(raw, pos + q1, q2 - q1 - 1) ~ tag_re
				}
				# scan: note each run-mode call in the statement st (raw as written).
				function scan(   rest, off, call, at, k, line) {
					rest = st; off = 0
					while (match(rest, call_re)) {
						at = off + RSTART + 1
						call = substr(rest, RSTART + 1, RLENGTH - 1); sub(/[ \t]*\($/, "", call); gsub(/[ \t]/, "", call)
						off += RSTART + RLENGTH - 2
						rest = substr(rest, RSTART + RLENGTH - 1)
						if (call == "OS.has_feature" && !run_tag(off + 2)) continue
						line = lno[1]
						for (k = 2; k <= nl && lstart[k] <= at; k++) line = lno[k]
						n++; hfile[n] = sfile; hline[n] = line; hcall[n] = call
					}
					st = ""; raw = ""; nl = 0
				}
				FNR == 1 { if (st != "") scan(); tq = "" }
				{
					sub(/\r$/, "")
					b = blank($0)
					if (b ~ /^[ \t]*@tool([^A-Za-z0-9_]|$)/) tool[FILENAME] = 1
					if (st == "") sfile = FILENAME
					nl++; lstart[nl] = length(st) + 2; lno[nl] = FNR
					# A line ending in a backslash goes on: the backslash becomes a blank,
					# in the raw text too, so the two stay the same length.
					cont = match(b, /\\[ \t]*$/)
					rawl = $0
					if (cont) { b = substr(b, 1, RSTART - 1) " " substr(b, RSTART + 1); rawl = substr(rawl, 1, RSTART - 1) " " substr(rawl, RSTART + 1) }
					st = st " " b; raw = raw " " rawl
					if (depth(st) > 0 || cont) next
					scan()
				}
				END {
					if (st != "") scan()
					for (i = 1; i <= n; i++) {
						if (hcall[i] == "Engine.is_editor_hint" && (hfile[i] in tool)) continue
						print hfile[i] "\t" hline[i] "\t" hcall[i]
					}
				}
			' "${files[@]}"
		)"
	fi
	printf '%s\n' "$found" | awk -F'\t' -v allowed="$allowed" '
		BEGIN { n = split(allowed, a, "\n"); for (i = 1; i <= n; i++) { split(a[i], e, "\t"); if (e[2] != "") ok[e[2]] = 1 } }
		$1 != "" && !($1 in ok) { print $1 ":" $2 " " $3 "() checks how the game is run; take that choice from config or a seam" }
	'
	printf '%s\n' "$allowed" | awk -F'\t' -v found="$found" -v list="$RUN_MODE_ALLOWLIST" '
		BEGIN { n = split(found, f, "\n"); for (i = 1; i <= n; i++) { split(f[i], e, "\t"); if (e[1] != "") used[e[1]] = 1 } }
		$2 != "" && !($2 in used) { print list ":" $1 " lists " $2 ", which checks nothing about how the game is run; remove it" }
	'
}

# --- the Godot probe ----------------------------------------------------------

# What the text can't show (a script's base type and fields, runtime signal wiring,
# SceneState) comes from _arch_probe.gd, run once per arch run, headless, in one
# process. GODOT_BIN comes from tools/verify/local.env. The probe needs the class
# cache that prepare's import writes.
ARCH_PROBE="$FACTORY_STEPS_DIR/_arch_probe.gd"
ARCH_TMP="$(mktemp -d)"
trap 'rm -rf "$ARCH_TMP"' EXIT

# class_index: `class<TAB>file` for each product script's class_name.
class_index() {
	local files
	mapfile -t files < <(product_scripts)
	gd_code "${files[@]}" | awk -F'\t' '
		match($3, /^class_name[ \t]+[A-Za-z_][A-Za-z0-9_]*/) {
			c = substr($3, RSTART, RLENGTH); sub(/^class_name[ \t]+/, "", c); print c "\t" $1
		}
	'
}

# product_scenes: every checked scene that isn't a test.
product_scenes() { arch_files | grep -E '\.tscn$' | grep -Ev "$TESTS_RE"; }

# probe: the probe's lines, tab-separated, without the ARCH field. Godot runs on
# the first call only. When Godot can't run, the lines are `error` lines.
probe() {
	if [ ! -f "$ARCH_TMP/probe" ]; then
		run_probe > "$ARCH_TMP/probe.part"
		mv "$ARCH_TMP/probe.part" "$ARCH_TMP/probe"
	fi
	cat "$ARCH_TMP/probe"
}

run_probe() {
	local godot="${GODOT_BIN:-}" args=() f cls status
	if [ -z "$godot" ] || ! command -v "$godot" > /dev/null 2>&1; then
		printf 'error\t%s\tneeds Godot; set GODOT_BIN in %s/local.env\n' "$ARCH_PROBE" "$FACTORY_STEPS_DIR"
		return 0
	fi
	if [ ! -f "$ARCH_PROBE" ]; then
		printf 'error\t%s\tis missing; the arch step runs it\n' "$ARCH_PROBE"
		return 0
	fi
	while IFS=$'\t' read -r _ f; do
		[ -n "$f" ] && args+=(model "res://$f")
	done < <(plain_models)
	while IFS= read -r f; do
		args+=(scene "res://$f")
	done < <(product_scenes)
	"$godot" --headless --path . -s "res://$ARCH_PROBE" -- "${args[@]}" > "$ARCH_TMP/godot.out"
	status=$?
	tr -d '\r' < "$ARCH_TMP/godot.out" | sed -n 's/^ARCH\t//p' | sed 's|res://||g'
	[ "$status" -eq 0 ] || printf 'error\t%s\tGodot exited %s\n' "$ARCH_PROBE" "$status"
}

# probe_errors <path regex>: a finding for each probe error on a matching path.
probe_errors() {
	probe | awk -F'\t' -v re="$1" '$1 == "error" && $2 ~ re { print $2 ":1 " $3 }'
}

# --- R2 model-plain -----------------------------------------------------------

# The plain-model classes, by class_name, space-separated: each is a RefCounted
# with no Node fields, get_tree, await or preload. The project names its own;
# none are checked until it does.
PLAIN_MODELS=''

# The plain-model folders, space-separated paths from the project root with no
# trailing slash: every product script at any depth under one is a plain model
# too, named by its class_name or else its file name. A missing or empty folder
# checks nothing. The project names its own; none are checked until it does.
PLAIN_MODEL_DIRS=''

# plain_models: `name<TAB>file` for each plain model, one line per file: the
# PLAIN_MODELS classes (file empty for one no product script declares), then each
# product script under PLAIN_MODEL_DIRS.
plain_models() {
	local index cls dir
	index="$(class_index)"
	{
		for cls in $PLAIN_MODELS; do
			printf '%s\t%s\n' "$cls" "$(printf '%s\n' "$index" | awk -F'\t' -v c="$cls" '$1 == c { print $2; exit }')"
		done
		for dir in $PLAIN_MODEL_DIRS; do
			product_scripts | awk -v d="${dir%/}/" 'index($0, d) == 1'
		done | awk -F'\t' -v classes="$index" '
			BEGIN {
				n = split(classes, l, "\n")
				for (i = 1; i <= n; i++) { split(l[i], e, "\t"); if (e[2] != "" && !(e[2] in named)) named[e[2]] = e[1] }
			}
			{ name = $0; sub(/^.*\//, "", name); if ($0 in named) name = named[$0]; print name "\t" $0 }
		'
	} | awk -F'\t' '$2 == "" || !seen[$2]++'
}

check_model_plain() {
	local models model cls file
	mapfile -t models < <(plain_models)
	for model in "${models[@]}"; do
		cls="${model%%$'\t'*}"
		file="${model#*$'\t'}"
		if [ -z "$file" ]; then
			echo "$FACTORY_STEPS_DIR/arch:1 no product script declares class_name $cls, the plain model R2 checks"
			continue
		fi
		gd_code "$file" | awk -F'\t' -v cls="$cls" '
			{
				code = $3
				gsub(/"([^"\\]|\\.)*"/, "\"\"", code)
				gsub(/\047([^\047\\]|\\.)*\047/, "\047\047", code)
				if (code ~ /^[ \t]*(class_name|extends)[ \t]/) {
					if (code !~ /^extends/) next
					print "extends\t" $2
					next
				}
				rest = code
				while (match(rest, /(^|[^A-Za-z0-9_])(get_tree|await|preload)([^A-Za-z0-9_]|$)/)) {
					w = substr(rest, RSTART, RLENGTH); gsub(/[^A-Za-z_]/, "", w)
					print "finding\t" $1 ":" $2 " " cls " uses " w "; the model stays plain"
					rest = substr(rest, RSTART + RLENGTH)
				}
				if (match(code, /^[ \t]*(@[A-Za-z_]+([(][^)]*[)])?[ \t]+)*(static[ \t]+)?var[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
					v = substr(code, RSTART, RLENGTH); sub(/^.*var[ \t]+/, "", v)
					print "var\t" v "\t" $2
				}
			}
		' > "$ARCH_TMP/model"
		awk -F'\t' '$1 == "finding" { print $2 }' "$ARCH_TMP/model"
		probe | awk -F'\t' -v file="$file" -v cls="$cls" -v lines="$ARCH_TMP/model" '
			BEGIN {
				ext = 1
				while ((getline l < lines) > 0) {
					split(l, e, "\t")
					if (e[1] == "extends") ext = e[2]
					else if (e[1] == "var" && !(e[2] in at)) at[e[2]] = e[3]
				}
			}
			$1 == "error" && $2 == file { print file ":1 " $3 }
			$1 == "model" && $2 == file && $3 == "base" { print file ":" ext " " cls " extends " $4 ", not RefCounted" }
			$1 == "model" && $2 == file && $3 == "node-field" {
				print file ":" ($4 in at ? at[$4] : 1) " " cls " has a Node field " $4 " (" $5 "); the model holds no nodes"
			}
		'
	done
	probe_errors "^$ARCH_PROBE\$"
}

# --- R4 layers ----------------------------------------------------------------

ARCH_DOC=ARCHITECTURE.md

# Folders beside the layer line, and the only folders that may use them, as
# space-separated `leaf:user,user` items. A leaf uses nothing outside itself.
# The project names its own; there are none until it does.
LAYER_LEAVES=''

# layer_line: `index<TAB>folder` for each folder on ARCHITECTURE.md's layer line,
# the first line under `## Layers` that starts with a backtick and holds an arrow.
# Folders split by `|` share an index and don't use each other.
layer_line() {
	tr -d '\r' < "$ARCH_DOC" | awk '
		/^## / { in_layers = ($0 ~ /^## Layers[ \t]*$/); next }
		in_layers && /^`/ && /→/ {
			n = split($0, step, "→")
			for (i = 1; i <= n; i++) {
				m = split(step[i], alt, "|")
				for (j = 1; j <= m; j++) {
					f = alt[j]; gsub(/[` \t]/, "", f)
					if (f != "") print i "\t" f
				}
			}
			exit
		}
	'
}

check_layers() {
	local files layers
	layers="$(layer_line)"
	if [ -z "$layers" ]; then
		echo "$ARCH_DOC:1 has no layer line under ## Layers; R4 checks against it"
		return 0
	fi
	mapfile -t files < <(product_scripts)
	{
		printf '%s\n' "$layers" | awk -F'\t' '{ print "layer\t" $1 "\t" $2 }'
		# shellcheck disable=SC2086 # one leaf per word
		printf '%s\n' $LAYER_LEAVES | awk -F: '{ print "leaf\t" $1 "\t" $2 }'
		class_index | awk -F'\t' '{ print "class\t" $1 "\t" $2 }'
		gd_code "${files[@]}" | awk -F'\t' '{ print "code\t" $0 }'
	} | awk -F'\t' '
		# unit_of(path): the layer folder or leaf holding <path>, the longest match.
		function unit_of(p,   u, best) {
			best = ""
			for (u in kind) if ((p == u || index(p, u "/") == 1) && length(u) > length(best)) best = u
			return best
		}
		function judge(file, line, name, target,   s, t, users) {
			s = unit_of(file); t = unit_of(target)
			if (s == "" || t == "" || s == t) return
			key = file SUBSEP line SUBSEP name
			if (key in told) return
			told[key] = 1
			if (kind[t] == "leaf") {
				users = "," leaf_users[t] ","
				if (index(users, "," s ",") == 0) printf "%s:%s uses %s from %s, a leaf only %s may use\n", file, line, name, t, leaf_users[t]
			} else if (kind[s] == "leaf") {
				printf "%s:%s uses %s from %s; %s is a leaf and uses nothing outside itself\n", file, line, name, t, s
			} else if (idx[t] <= idx[s]) {
				printf "%s:%s uses %s from %s, which is not below %s on the layer line\n", file, line, name, t, s
			}
		}
		$1 == "layer" { kind[$3] = "layer"; idx[$3] = $2 + 0; next }
		$1 == "leaf" { kind[$2] = "leaf"; leaf_users[$2] = $3; next }
		$1 == "class" { cls[$2] = $3; next }
		$1 == "code" {
			file = $2; line = $3; code = $4
			rest = code
			while (match(rest, /(preload|load)[ \t]*\([ \t]*"res:\/\/[^"]*"/)) {
				p = substr(rest, RSTART, RLENGTH); sub(/^[^"]*"res:\/\//, "", p); sub(/"$/, "", p)
				judge(file, line, p, p)
				rest = substr(rest, RSTART + RLENGTH)
			}
			if (match(code, /^extends[ \t]+"res:\/\/[^"]*"/)) {
				p = substr(code, RSTART, RLENGTH); sub(/^[^"]*"res:\/\//, "", p); sub(/"$/, "", p)
				judge(file, line, p, p)
			}
			gsub(/"([^"\\]|\\.)*"/, "\"\"", code)
			gsub(/\047([^\047\\]|\\.)*\047/, "\047\047", code)
			gsub(/[$%][A-Za-z0-9_\/]+/, "", code)
			rest = code
			while (match(rest, /(^|[^A-Za-z0-9_.])[A-Z][A-Za-z0-9_]*/)) {
				t = substr(rest, RSTART, RLENGTH); sub(/^[^A-Z]/, "", t)
				rest = substr(rest, RSTART + RLENGTH)
				if ((t in cls) && cls[t] != file) judge(file, line, t, cls[t])
			}
		}
	'
}

# --- R5 signals-up ------------------------------------------------------------

# The probe walks every product scene at runtime. A connection whose target is
# neither the emitter nor one of its ancestors is reported where it is made: a
# scene's connection at its [connection] line, one made in code at the first script
# line calling <signal>.connect( with the method's name; else at the scene.
check_signals_up() {
	local files scenes
	mapfile -t files < <(product_scripts)
	mapfile -t scenes < <(product_scenes)
	{
		probe | awk -F'\t' '$1 == "signal" { print }'
		gd_code "${files[@]}" | awk -F'\t' '{ print "code\t" $0 }'
		[ "${#scenes[@]}" -gt 0 ] && awk '/^\[connection / { sub(/\r$/, ""); print "conn\t" FILENAME "\t" FNR "\t" $0 }' "${scenes[@]}"
	} | awk -F'\t' '
		function word(s, w) { return s ~ ("(^|[^A-Za-z0-9_])" w "([^A-Za-z0-9_]|$)") }
		$1 == "signal" { n++; em[n] = $2; sig[n] = $3; tg[n] = $4; me[n] = $5; pe[n] = $6; sc[n] = $7; next }
		$1 == "code" { c++; cf[c] = $2; cl[c] = $3; cc[c] = $4; next }
		$1 == "conn" { k++; kf[k] = $2; kl[k] = $3; kc[k] = $4; next }
		END {
			for (i = 1; i <= n; i++) {
				at = ""
				lambda = (me[i] ~ /^</)
				pe[i] = (pe[i] == "1")
				for (j = 1; j <= c && at == "" && !pe[i]; j++)
					if (cc[j] ~ ("(^|[^A-Za-z0-9_])" sig[i] "\\.connect\\(") && (lambda || word(cc[j], me[i]))) at = cf[j] ":" cl[j]
				for (j = 1; j <= k && at == "" && pe[i]; j++)
					if (index(kc[j], "signal=\"" sig[i] "\"") && index(kc[j], "method=\"" me[i] "\"") && kc[j] ~ ("from=\"(([^\"]*/)?" em[i] "|[.])\"")) at = kf[j] ":" kl[j]
				if (at == "") at = sc[i] ":1"
				printf "%s %s.%s is connected to %s.%s, which is not %s or an ancestor of it; relay it through their common parent\n", at, em[i], sig[i], tg[i], me[i], em[i]
			}
		}
	' | LC_ALL=C sort -u
	probe_errors '[.]tscn$'
	probe_errors "^$ARCH_PROBE\$"
}

# --- R8 mirrored-tests --------------------------------------------------------

# Every product script has tests/<path>/<name>_test.gd; the R11 @tool allowlist is
# exempt.
check_mirrored_tests() {
	local files
	files="$(arch_files)"
	product_scripts | awk -v files="$files" -v allowed="$(ratchet_entries "$TOOL_ALLOWLIST")" '
		BEGIN {
			n = split(files, f, "\n"); for (i = 1; i <= n; i++) have[f[i]] = 1
			n = split(allowed, a, "\n"); for (i = 1; i <= n; i++) { split(a[i], e, "\t"); if (e[2] != "") tool[e[2]] = 1 }
		}
		$0 in tool { next }
		{
			t = "tests/" substr($0, 1, length($0) - 3) "_test.gd"
			if (!(t in have)) print $0 ":1 has no test at " t
		}
	'
}

# --- R12 no-sideways-refs -----------------------------------------------------

# The probe reads each scene's SceneState: an exported NodePath or Node-typed
# property (`node_paths`) whose path leaves the scene its node belongs to is
# reported at the script's `var`. A node that instances a scene belongs to that
# scene, so it may not reach outside its own subtree, wherever the value is set;
# any other node may reach anywhere in the scene that defines it, siblings
# included.
check_no_sideways_refs() {
	local refs
	refs="$(probe | awk -F'\t' '$1 == "ref"')"
	if [ -n "$refs" ]; then
		printf '%s\n' "$refs" | while IFS=$'\t' read -r _ script node prop ref scene bound; do
			local line
			line="$(gd_code "$script" 2> /dev/null | awk -F'\t' -v p="$prop" '
				$3 ~ ("(^|[ \t])var[ \t]+" p "([^A-Za-z0-9_]|$)") { print $2; exit }
			')"
			if [ "$bound" = scene ]; then
				echo "$script:${line:-1} $node.$prop points at $ref, outside $scene, the scene $node belongs to; pass it down from the parent instead"
			else
				echo "$script:${line:-1} $node.$prop points at $ref, outside $node's own subtree (set in $scene); pass it down from the parent instead"
			fi
		done | LC_ALL=C sort -u
	fi
	probe_errors '[.]tscn$'
	probe_errors "^$ARCH_PROBE\$"
}

