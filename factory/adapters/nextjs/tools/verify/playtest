#!/usr/bin/env bash
# The playtest step (not a gate: the run calls it after the Drift sweep). It
# builds the app for production (next build, offline) and prints how to start it
# locally; the human starts it and opens the URL. A project tailors it (to deploy
# a preview, say) when it adopts.
#   bash tools/verify/playtest
#
# FACTORY_PLAYTEST_PORT (local.env) is the port the start command names; the
# default is 3000.
#
# stdout, on success, and nothing else: one line,
#   pnpm exec next start --port <port>   then open http://localhost:<port>
# When local.env names Node or pnpm by a path (NODE_BIN, PNPM_BIN), the command
# puts their folders first on PATH: PATH=<folders>:"$PATH" pnpm exec ....
# The build's output goes to stderr. It builds under the machine-wide build lock
# (_nextjs.sh's nx_next_build), so it queues behind a gate's build instead of
# colliding with it; FACTORY_BUILD_WAIT (local.env; seconds, default 900) bounds
# the wait.
#
# The build is from source: just before next build starts, under that lock (so
# no other build through it, in this checkout or another, is running), it removes
# this checkout's .next/cache/turbopack, Turbopack's build cache, and nothing else
# (.next/cache's other caches, other checkouts). A stale cache there once built a
# playtest whose CSS mixed new and old values, and the human judges a playtest by
# eye. The cold build is slower; a cache it can't remove fails the playtest.
# Exits 0 with the app built, 1 otherwise (the reason on stderr).
#
# Run bare (the build skill's playtest.md), it reads tools/verify/local.env itself, as
# verify.sh does for the gate's steps, so its build meets theirs under the same
# FACTORY_BUILD_LOCK.
set -u

if [ -f tools/verify/local.env ]; then
	set -a
	# shellcheck disable=SC1091 # the machine's own, gitignored
	. ./tools/verify/local.env
	set +a
fi
. "$(dirname "${BASH_SOURCE[0]}")/_nextjs.sh"

# tool (_nextjs.sh's), but next build first removes .next/cache/turbopack:
# nx_next_build runs `tool next build` once it holds the build lock.
tool() {
	local name="$1"
	shift
	if [ "$name" = next ] && [ "${1:-}" = build ] && { [ -e .next/cache/turbopack ] || [ -L .next/cache/turbopack ]; }; then
		if ! rm -rf .next/cache/turbopack || [ -e .next/cache/turbopack ]; then
			echo "playtest: could not remove .next/cache/turbopack, Turbopack's build cache; remove it, then run again" >&2
			return 1
		fi
		echo "playtest: removed .next/cache/turbopack, so the build is from source" >&2
	fi
	"node_modules/.bin/$name" "$@"
}

port="${FACTORY_PLAYTEST_PORT:-3000}"
case "$port" in
	'' | *[!0-9]*)
		echo "playtest: FACTORY_PLAYTEST_PORT is '$port', not a port number" >&2
		exit 1
		;;
esac
if ! tool_ready next > /dev/null; then
	tool_ready next | sed 's/^[^ ]* [^ ]* /playtest: /' >&2
	exit 1
fi
trap 'nx_build_unlock' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
nx_next_build
status=$?
if [ "$status" -ne 0 ]; then
	echo "playtest: $NX_BUILD_MSG" >&2
	exit 1
fi
prefix=""
for bin in "${NODE_BIN:-}" "${PNPM_BIN:-}"; do
	case "$bin" in */*) prefix="$prefix$(printf '%q' "$(dirname "$bin")"):" ;; esac
done
[ -z "$prefix" ] || prefix="PATH=$prefix\"\$PATH\" "
printf '%spnpm exec next start --port %s   then open http://localhost:%s\n' "$prefix" "$port" "$port"
