#!/usr/bin/env bash
# The lint step: ESLint (the project's, pinned in tools/verify/pins) with the
# project's flat config, knip and a secret scan (secretlint), plus the adapter's
# own checks (_lint_checks.awk).
#   bash tools/verify/lint
#
# ESLint lints every code file in scope (_nextjs.sh: .ts, .tsx, .mts, .cts, .js,
# .jsx, .mjs, .cjs) with --no-inline-config, so an eslint-disable comment turns
# no rule off: a finding is fixed, or the Baseline holds it. The config is the
# project's (eslint.config.mjs; the skeleton's turns on typescript-eslint's
# strict type-aware rules, no-floating-promises and the no-unsafe-* among them,
# React's Rules of Hooks with its React Compiler rules (eslint-plugin-react-hooks)
# and Next.js's core-web-vitals rules, @next/next/no-img-element among them).
# Every message is a finding, a warning too; a file in scope the config ignores
# is one as well (lint-ignored), so the config can't drop a file unseen.
#
# knip (pinned) finds dead code over the whole project, by the project's knip
# config (the skeleton's knip.json; with none, knip's defaults): a file nothing
# imports, an export nothing imports, a dependency nothing uses, an import of a
# package package.json doesn't list. Each issue in a file in scope is a finding,
# knip-<kind> (_knip_findings.mjs); package.json is in scope by default. Its
# Next.js, Vitest and Playwright plugins name the entry files (pages, layouts,
# routes, configs, tests); a dependency only a gate step runs from tools/verify
# (prettier, dependency-cruiser) is one knip can't see used, so the skeleton's
# knip.json lists it in ignoreDependencies, as it does server-only and
# client-only, which Next.js bundles (R6 names server-only) unlisted.
#
# secretlint (pinned) scans every file in scope, any extension, for a committed
# secret: cloud and service tokens (AWS, GCP, GitHub, Slack, npm and more),
# private keys, credentials in a URL. The rules are the project's
# .secretlintrc.* (the skeleton's .secretlintrc.json turns on the recommended
# preset), or that preset when there is none. Each message is a finding, secret-<rule>
# (_secretlint_findings.mjs), its secret masked. A file .gitignore ignores is out
# of scope already (.env* among them), so it is scanned only once it is tracked.
#
# The adapter's own checks read the test files in scope (tools/verify/test-paths):
# assertion-free (a test that asserts nothing) and fixed-wait (a test that waits
# a fixed time); _lint_checks.awk says what each counts.
#
# Findings, on stdout (ESLint's own output goes to stderr):
#   <file>:<line> <rule> <message>     an ESLint message (_eslint_findings.mjs has
#                                      lint-parse, lint-ignored and lint-other), or
#                                      one of the adapter's checks
#   <file>:<line> knip-<kind> <message>     a knip issue (_knip_findings.mjs)
#   <file>:<line> secret-<rule> <message>   a secret (_secretlint_findings.mjs)
#   tools/verify/lint:1 lint-error <message>   ESLint, knip or secretlint failed
#                                      without a report
#   (and node-missing or tool-missing, as _nextjs.sh has them)
# Exits 1 on any finding.
#
# Porting this step into a project made before knip and secretlint ran here: copy
# the skeleton's (factory/adapters/nextjs/new/, each .txt dropped) knip.json and
# .secretlintrc.json; add its devDependencies eslint-plugin-react-hooks,
# @next/eslint-plugin-next, knip and secretlint, and its dependency zod, at the
# versions it pins, to package.json (pnpm install); add the two plugins to
# eslint.config.mjs as the skeleton's has them; port typecheck, arch and pins too
# (their headers say what). Then record what the new rules find in old code:
# bash factory/core/baseline.sh add <rule>... (the knip-*, secret-*,
# react-hooks/* and @next/next/* rules it reports).
set -u

dir="$(dirname "${BASH_SOURCE[0]}")"
. "$dir/_nextjs.sh"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

nx_files > "$tmp/all"
# shellcheck disable=SC2086 # the extension list splits on purpose
nx_files $NX_CODE_EXT > "$tmp/files"
nx_tests < "$tmp/files" > "$tmp/tests"
[ -s "$tmp/all" ] || exit 0
node_ready || exit 1

{
	if [ -s "$tmp/files" ] && tool_ready eslint; then
		mapfile -t files < "$tmp/files"
		tool eslint --no-inline-config --format json --output-file "$tmp/report.json" "${files[@]}" > "$tmp/log" 2>&1
		status=$?
		cat "$tmp/log" >&2
		# ESLint exits 1 when it reports a problem, 2 when it couldn't lint.
		if [ "$status" -gt 1 ] || [ ! -s "$tmp/report.json" ]; then
			echo "tools/verify/lint:1 lint-error ESLint exited $status without a report (see stderr)"
		elif ! "${NODE_BIN:-node}" "$dir/_eslint_findings.mjs" "$tmp/report.json"; then
			echo "tools/verify/lint:1 lint-error could not read ESLint's report (see stderr)"
		fi
	fi
	if [ -s "$tmp/files" ] && tool_ready knip; then
		# knip exits 1 when it reports an issue, 2 when it couldn't run.
		tool knip --no-progress --no-config-hints --reporter json > "$tmp/knip.json" 2> "$tmp/knip.log"
		status=$?
		cat "$tmp/knip.log" >&2
		if [ "$status" -gt 1 ] || [ ! -s "$tmp/knip.json" ]; then
			cat "$tmp/knip.json" >&2
			echo "tools/verify/lint:1 lint-error knip exited $status without a report (see stderr)"
		elif ! "${NODE_BIN:-node}" "$dir/_knip_findings.mjs" "$tmp/knip.json" "$tmp/all"; then
			echo "tools/verify/lint:1 lint-error could not read knip's report (see stderr)"
		fi
	fi
	if tool_ready secretlint; then
		mapfile -t all < "$tmp/all"
		# The project's .secretlintrc.* when it has one (secretlint finds it), else
		# the recommended preset: never a config further up, outside the project.
		config=()
		compgen -G '.secretlintrc*' > /dev/null ||
			config=(--secretlintrcJSON '{"rules":[{"id":"@secretlint/secretlint-rule-preset-recommend"}]}')
		# With --output, secretlint exits 0 on a secret found, 2 when it couldn't scan.
		tool secretlint "${config[@]}" --format json --output "$tmp/secrets.json" --no-glob --no-gitignore --no-color "${all[@]}" > "$tmp/secrets.log" 2>&1
		status=$?
		cat "$tmp/secrets.log" >&2
		if [ "$status" -ne 0 ] || [ ! -s "$tmp/secrets.json" ]; then
			echo "tools/verify/lint:1 lint-error secretlint exited $status without a report (see stderr)"
		elif ! "${NODE_BIN:-node}" "$dir/_secretlint_findings.mjs" "$tmp/secrets.json"; then
			echo "tools/verify/lint:1 lint-error could not read secretlint's report (see stderr)"
		fi
	fi
	if [ -s "$tmp/tests" ]; then
		mapfile -t tests < "$tmp/tests"
		awk -f "$dir/_lint_checks.awk" "${tests[@]}"
	fi
} > "$tmp/findings"

LC_ALL=C sort "$tmp/findings"
[ ! -s "$tmp/findings" ]
